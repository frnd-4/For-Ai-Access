{
  "name": "brta-voiceover-synced-remotion",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare-routes": "node scripts/prepare-routes.mjs",
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "render:version1": "remotion render src/index.ts BRTAFourCorridors out/brta-four-corridors.mp4",
    "render:version2": "remotion render src/index.ts BRTAWithAlternative out/brta-with-alternative.mp4",
    "render:all": "npm run render:version1 && npm run render:version2",
    "render:route1": "remotion render src/index.ts AbdullahpurGazipurRoute out/route-01-abdullahpur-gazipur.mp4",
    "render:route2": "remotion render src/index.ts JatrabariSanarparRoute out/route-02-jatrabari-sanarpar.mp4",
    "render:route3": "remotion render src/index.ts JatrabariEkuriaRoute out/route-03-jatrabari-ekuria.mp4",
    "render:route4": "remotion render src/index.ts GabtoliHemayetpurRoute out/route-04-gabtoli-hemayetpur.mp4",
    "render:route5": "remotion render src/index.ts AirportJamunaBridgeRoute out/route-05-airport-jamuna-bridge.mp4"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "dotenv": "^16.4.7",
    "mapbox-gl": "^3.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-map-gl": "^8.0.4",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.7.0"
  }
}